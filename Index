<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <style>
    body { 
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
      text-align: center; 
      padding: 50px; 
      background: #f4f4f9; 
      color: #333; 
    }
    h1 { color: #2c3e50; }
    
    #connectBtn { 
      padding: 15px 30px; 
      font-size: 18px; 
      cursor: pointer; 
      background: #3498db; 
      color: white; 
      border: none; 
      border-radius: 8px; 
      margin-bottom: 30px; 
      transition: background 0.3s;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    #connectBtn:hover { background: #2980b9; }
    
    .display-card { 
      background: white; 
      padding: 40px; 
      border-radius: 12px; 
      box-shadow: 0 4px 15px rgba(0,0,0,0.05); 
      display: inline-block; 
      min-width: 250px;
    }
    
    .force-value { 
      font-size: 64px; 
      font-weight: bold; 
      color: #e74c3c; 
      margin: 10px 0; 
    }
    .unit { font-size: 24px; color: #7f8c8d; }
  </style>
</head>
<body>
  <h1>Griptonite Motherboard</h1>
  <button id="connectBtn">Connect via Bluetooth</button>
  
  <br>
  
  <div class="display-card">
    <div style="font-size: 18px; text-transform: uppercase; letter-spacing: 1px; color: #7f8c8d;">Peak Force</div>
    <div class="force-value"><span id="peak">0.00</span> <span class="unit">kg</span></div>
    <div style="font-size: 16px; color: #95a5a6; margin-top: 15px;">Current Load: <span id="current">0.00</span> kg</div>
  </div>

  <!-- Import the open-source hangtime library directly via ESM CDN -->
  <script type="module">
    import { Motherboard } from "https://esm.sh/@hangtime/grip-connect";

    const motherboard = new Motherboard();
    const connectBtn = document.getElementById("connectBtn");
    const peakEl = document.getElementById("peak");
    const currentEl = document.getElementById("current");

    // Subscribe to incoming telemetry data from the Motherboard
    motherboard.notify((data) => {
      // The library parses { unit, timestamp, current, peak, mean }
      if (data.peak !== undefined) peakEl.innerText = data.peak.toFixed(2);
      if (data.current !== undefined) currentEl.innerText = data.current.toFixed(2);
    });

    // Handle Bluetooth connection
    connectBtn.addEventListener("click", async () => {
      try {
        connectBtn.innerText = "Requesting Connection...";
        
        await motherboard.connect(
          async () => {
            // Success Callback
            connectBtn.innerText = "Connected & Streaming";
            connectBtn.style.background = "#2ecc71";
            
            // Start continuous weight streaming
            await motherboard.stream();
          }, 
          (error) => {
            // Disconnect/Error Callback
            console.error("Motherboard disconnected:", error.message);
            connectBtn.innerText = "Connection Lost - Click to Reconnect";
            connectBtn.style.background = "#e74c3c";
          }
        );
      } catch (error) {
        console.error(error);
        connectBtn.innerText = "Connect via Bluetooth";
        alert("Failed to connect. Ensure your board is powered on, Bluetooth is enabled, and you are using a supported browser (Chrome or Edge).");
      }
    });
  </script>
</body>
</html>
